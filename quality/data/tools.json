[
  {
    "id": "tool-01",
    "prompt": "What is the current weather in Rome in Celsius? Use the provided tool to answer.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get the current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {"type": "string", "description": "City name."},
              "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}
            },
            "required": ["city", "unit"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_forecast",
          "description": "Get a multi-day weather forecast.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {"type": "string"},
              "days": {"type": "integer", "minimum": 1, "maximum": 14}
            },
            "required": ["city", "days"]
          }
        }
      }
    ],
    "expect": {"name": "get_weather", "args": {"city": "Rome", "unit": "celsius"}},
    "arg_specs": {"city": {"match": "contains"}}
  },
  {
    "id": "tool-02",
    "prompt": "Create a calendar event titled 'Sprint Review' on 2025-06-10 lasting 45 minutes. Use the provided tool.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "add_event",
          "description": "Create a calendar event.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "date": {"type": "string", "description": "Event date in ISO format YYYY-MM-DD."},
              "duration_minutes": {"type": "integer"}
            },
            "required": ["title", "date", "duration_minutes"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "list_events",
          "description": "List calendar events for a date range.",
          "parameters": {
            "type": "object",
            "properties": {"start": {"type": "string"}, "end": {"type": "string"}},
            "required": ["start", "end"]
          }
        }
      }
    ],
    "expect": {"name": "add_event", "args": {"title": "Sprint Review", "date": "2025-06-10", "duration_minutes": 45}},
    "arg_specs": {
      "title": {"match": "contains"},
      "date": {"aliases": {"2025-06-10": ["June 10, 2025", "June 10 2025", "10 June 2025", "2025/06/10"]}}
    }
  },
  {
    "id": "tool-03",
    "prompt": "Search the repository /home/user/project for Python files matching *.py, returning at most 20 results. Use the provided tool.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "search_files",
          "description": "Search a directory tree for files matching a glob pattern.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "pattern": {"type": "string"},
              "max_results": {"type": "integer"}
            },
            "required": ["path", "pattern", "max_results"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "Read the contents of a file.",
          "parameters": {
            "type": "object",
            "properties": {"path": {"type": "string"}},
            "required": ["path"]
          }
        }
      }
    ],
    "expect": {"name": "search_files", "args": {"path": "/home/user/project", "pattern": "*.py", "max_results": 20}},
    "arg_specs": {"path": {"match": "contains"}, "pattern": {"match": "contains"}}
  },
