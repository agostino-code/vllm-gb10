  {
    "id": "json-07",
    "prompt": "Return a JSON object with exactly two keys: 'items' and 'total'. 'items' is an array of exactly 4 objects; each object has the keys 'sku' (string matching the pattern SKU- followed by exactly 4 digits), 'qty' (integer >= 1) and 'price' (number > 0). 'total' is a number. Output only the JSON, nothing else.",
    "schema": {
      "type": "object",
      "exactly_keys": [
        "items",
        "total"
      ],
      "required": [
        "items",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "exactly_keys": [
              "sku",
              "qty",
              "price"
            ],
            "required": [
              "sku",
              "qty",
              "price"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "pattern": "^SKU-[0-9]{4}$"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              },
              "price": {
                "type": "number",
                "minimum": 0.01
              }
            }
          }
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  {
    "id": "json-08",
    "prompt": "Return a JSON object with exactly two keys: 'config' and 'tags'. 'config' is an object with keys 'host' (string), 'port' (integer 1-65535), 'tls' (boolean) and 'retries' (integer 0-10). 'tags' is an array of exactly 3 unique strings. Output only the JSON, nothing else.",
    "schema": {
      "type": "object",
      "exactly_keys": [
        "config",
        "tags"
      ],
      "required": [
        "config",
        "tags"
      ],
      "properties": {
        "config": {
          "type": "object",
          "exactly_keys": [
            "host",
            "port",
            "tls",
            "retries"
          ],
          "required": [
            "host",
            "port",
            "tls",
            "retries"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tls": {
              "type": "boolean"
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  {
    "id": "json-09",
    "prompt": "Return a JSON array of exactly 6 unique strings. Each string must be 3-20 characters long and contain only lowercase letters, digits and underscores. Output only the JSON, nothing else.",
    "schema": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 20,
        "pattern": "^[a-z0-9_]{3,20}$"
      }
    }
  },
