[
  {
    "id": "json-01",
    "prompt": "Return a JSON array of exactly 5 objects describing the first five planets from the Sun. Each object must have the keys 'name' (string), 'moons' (non-negative integer) and 'order' (integer from 1 to 8). Output only the JSON, nothing else.",
    "schema": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "moons",
          "order"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "moons": {
            "type": "integer",
            "minimum": 0
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    }
  },
  {
    "id": "json-02",
    "prompt": "Invent a plausible book and return a JSON object with exactly the keys 'title', 'author', 'year' and 'genres'. 'title' and 'author' are strings, 'year' is an integer, and 'genres' is an array of at least 2 strings. Output only the JSON, nothing else.",
    "schema": {
      "type": "object",
      "exactly_keys": [
        "title",
        "author",
        "year",
        "genres"
      ],
      "required": [
        "title",
        "author",
        "year",
        "genres"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1400,
          "maximum": 2100
        },
        "genres": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  },
  {
