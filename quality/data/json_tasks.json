            "name": {
              "type": "string",
              "minLength": 1
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  {
