    "prompt": "Return a JSON array of exactly 10 objects. Each object must have the keys 'id' (integer from 1 to 10) and 'status' (one of 'ok', 'warn', 'error'). Output only the JSON, nothing else.",
    "schema": {
      "type": "array",
      "minItems": 10,
