# ═══════════════════════════════ SETTINGS ═══════════════════════════════
# Only the variables run.sh actually reads. Everything that describes the
# model — context, KV size, speculative depth, kernels, seats — lives in the
# recipe, which is the single source of truth. Nothing here is silently
# ignored: if a variable is not in this file, run.sh does not use it.
#
# Anything set in the environment overrides the recipe, so you can tune a
# single run without editing anything:
#     PORT=8010 IMAGE=myllmbox/qwen38-flash-next-vllm:v5.4 presets/run_az_standard.sh
# ---------------------------------------------------------------------------

IMAGE="${IMAGE:-myllmbox/qwen38-flash-next-vllm:v5.4}"   # serving image: tag, or digest (IMAGE@sha256:...)
PORT="${PORT:-8000}"                                     # host port for the OpenAI-compatible API
CONTAINER="${CONTAINER:-qwen38-flash-next}"               # docker container name

MODEL_REPO="${MODEL_REPO:-}"      # empty = the recipe's server.model
SERVED_NAME="${SERVED_NAME:-}"    # empty = the recipe's vllm.served-model-name
CHAT_TEMPLATE="${CHAT_TEMPLATE:-}" # empty = the model's stock template; else a path to a .jinja

DOWNLOAD_MODE="${DOWNLOAD_MODE:-cache}"   # cache = HF hub snapshot | local = $MODELS_DIR/<name>
HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
MODELS_DIR="${MODELS_DIR:-$PWD/models}"  # used only by DOWNLOAD_MODE=local

EXTRA_ARGS="${EXTRA_ARGS:-}"               # appended verbatim to the vLLM command line
DOCKER_EXTRA_ARGS="${DOCKER_EXTRA_ARGS:-}" # extra flags for `docker run` itself

DEFAULT_RECIPE="recipes/az-standard.yaml"
# ═════════════════════════════════════════════════════════════════════════

# --- where things live (you should not need to touch these) ---------------

# Resolve a repo id to the snapshot folder the Hugging Face cache put it in.
# Empty when the snapshot is not there (yet).
hf_snapshot_dir() {
  local repo="$1" d ref
  d="$HF_HOME/hub/models--${repo//\//--}"
  ref="$(cat "$d/refs/main" 2>/dev/null)" || return 1
  [ -d "$d/snapshots/$ref" ] || return 1
  printf '%s\n' "$d/snapshots/$ref"
}

# The container-side path the model is served from.
#
# WHY THE ABSOLUTE HUB PATH AND NOT /models/<name>:
# A Hugging Face snapshot is a directory of symlinks whose targets are
# relative (`../../blobs/<sha256>`). Bind-mounted at /models/<name> those
# links resolve to /blobs/<sha256> inside the container, which does not
# exist, and the weight load fails with "No such file or directory".
# Mounting the hub at its own host path and serving the snapshot from that
# same absolute path makes the relative links resolve natively. It works for
# both layouts the two checkpoints use: blob symlinks (hibrid48-uncensored)
# and plain files under tensors/ (FP4-Local-AZ). Verified with a container
# read of one shard of each.
HF_HUB_MOUNT="$HF_HOME/hub"
