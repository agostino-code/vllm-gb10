# Default recipe to use if none is provided
DEFAULT_RECIPE=qwen38-flash-solo-optimized.yaml

# ═══════════════════════════════ SETTINGS ═══════════════════════════════
# >>> SETTINGS >>>
MODEL_REPO="${MODEL_REPO:-azampatti/Qwen3.8-Flash-Next-FP4-Local-AZ}"  # which model
SERVED_NAME="${SERVED_NAME:-azampatti/Qwen3.8-Flash-Next-FP4-Local-AZ}"  # the name clients send as "model"
PORT="${PORT:-8000}"                                  # host port for the OpenAI-compatible API
BACKEND="${BACKEND:-v54}"                            # v54 (vLLM 0.32 + RecoverSSM + Dynamic Depth, recommended) | b12x | classic

CTX="${CTX:-262144}"                                  # max tokens in ONE request (prompt + output)
SEQS="${SEQS:-4}"                                     # how many requests may run at the same time
KV_BYTES="${KV_BYTES:-16g}"                           # KV cache size; 20g holds ~645k tokens total
KV_DTYPE="${KV_DTYPE:-auto}"                          # auto | fp8_e4m3  (fp8 = ~1.9x context, ~10% slower)

CHAT_TEMPLATE="${CHAT_TEMPLATE:-medium}"              # medium | xhigh | model (the model's own stock template) | /path/to/file.jinja. medium is what the speculative head was trained on: +5pp acceptance, +6% tok/s vs the stock template
TOOL_PARSER="${TOOL_PARSER:-qwen3_coder}"             # how tool calls are parsed out of the reply
REASONING_PARSER="${REASONING_PARSER:-qwen3}"         # puts <think> into its own "reasoning" field

MTP="${MTP:-0}"                                       # 0 = do not append a speculative-config: every recipe already carries its own (K=4..12). K<=3 does not boot on the v5.4 image (min depth 4).
DET_TOPK="${DET_TOPK:-0}"                             # 1 = deterministic expert top-k (slower, still not bit-exact)
REJECTION_SAMPLE="${REJECTION_SAMPLE:-block}"         # block | standard. block = joint verification of the drafted tokens (exact). Default since 2026-09-08: +2.4pp acceptance with DRAFT_SAMPLE=probabilistic
DRAFT_SAMPLE="${DRAFT_SAMPLE:-probabilistic}"         # probabilistic | greedy. probabilistic keeps the draft's full logits for the accept test (exact). Both only matter at temperature > 0
DRAFT_SCALE="${DRAFT_SCALE:-2}"                        # sharpen the draft: its logits are multiplied by this before the accept test. 2 measured +2.5pp acceptance and +4% tok/s (exact -- the reply itself does not change). 1 = off

IMAGE="${IMAGE:-qwen38-flash-dgx:a5b-int4}"           # the image setup.sh built
CONTAINER="${CONTAINER:-qwen38-flash}"                # docker container name
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.01}"                  # left tiny on purpose: KV_BYTES above sets the cache instead
BATCHED_TOKENS="${BATCHED_TOKENS:-8192}"              # prefill chunk size
SHM="${SHM:-16g}"                                     # container shared memory
PLE_PREWARM="${PLE_PREWARM:-0}"                       # 1 = read the whole n-gram table into page cache at boot (fast first tokens); 0 = lazy (frees ~48 GB of cache pressure while weights load)

DOWNLOAD_MODE="${DOWNLOAD_MODE:-cache}"               # cache = the standard HF cache | local = a plain folder
HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"        # where the HF cache lives (cache mode)
MODELS_DIR="${MODELS_DIR:-$HOME/models}"              # plain-folder location (local mode) + the small draft folder

EXTRA_ARGS="${EXTRA_ARGS:-}"                          # anything else to append to the vLLM command line
DOCKER_EXTRA_ARGS="${DOCKER_EXTRA_ARGS:-}"            # extra flags for docker run itself (bind mounts, -e variables)
# <<< SETTINGS <<<
# ════════════════════════════════════════════════════════════════════════

# --- rarely changed ----------------------------------------------------------------------------
# --- Dynamic KV Cache Calculation ---
get_kv_cache_bytes() {
    # Ottieni la memoria libera in MiB da nvidia-smi
    local free_mib
    free_mib=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -n 1 2>/dev/null || echo 0)
    if ! [[ "$free_mib" =~ ^[0-9]+$ ]]; then free_mib=0; fi
    
    # Riserva 4GB (4096 MiB) di buffer per il sistema
    local buffer_mib=4096
    local kv_mib=$((free_mib - buffer_mib))
    
    # Assicurati che non sia negativo
    if [ $kv_mib -lt 0 ]; then kv_mib=0; fi
    
    # Converte in Byte (vLLM richiede Byte)
    echo $((kv_mib * 1024 * 1024))
}

TABLE_REPO="${TABLE_REPO:-Saren/Qwen3.8-Flash-Next-ple-table-fp8}"   # only used if the model ships without its n-gram table
UPSTREAM_REPO="${UPSTREAM_REPO:-https://github.com/Saren-Arterius/qwen3.8-Flash-DGX-AutoRound.git}"
UPSTREAM_COMMIT="${UPSTREAM_COMMIT:-01c5914f322716b39fd71d5584ed800955582e65}"   # pinned (FULL SHA required); the build this model was validated against
UPSTREAM_IMAGE="${UPSTREAM_IMAGE:-qwen38-flash-dgx:upstream}"

# Eugr's b12x stack (https://github.com/eugr/spark-vllm-docker). When that repo is checked out, setup.sh pulls this image
# instead of building ours, and serve.sh launches through Eugr's run-recipe.sh. BACKEND=classic in serve.sh opts out.
# eugr-setup.sh pulls Eugr's latest b12x build (what his build-and-copy.sh --exp-b12x pulls) and tags it
# vllm-node-b12x-<image build date, YYYYMMDD>; the installed recipes' container: line is set to that tag. Validated: the
# 2026-10-15 build (vLLM 0.1.dev21830). The tag in use is recorded in .b12x-image (not in git); without it, the newest
# local vllm-node-b12x-YYYYMMDD image is used.
B12X_SOURCE="${B12X_SOURCE:-eugr/spark-vllm-b12x:latest}"
B12X_IMAGE_FILE="$(dirname "${BASH_SOURCE[0]}")/.b12x-image"
b12x_local_tag(){ { docker images --format '{{.Repository}}' 2>/dev/null | grep -E '^vllm-node-b12x-[0-9]{8}$' | sort | tail -1; } || true; }
if [ -z "${B12X_IMAGE:-}" ]; then
  B12X_IMAGE="$(cat "$B12X_IMAGE_FILE" 2>/dev/null || true)"
  [ -n "$B12X_IMAGE" ] || B12X_IMAGE="$(b12x_local_tag)"
fi
if [[ "$MODEL_REPO" =~ (FP4|nvfp4) ]]; then
  B12X_RECIPE="${B12X_RECIPE:-qwen3.8-flash-next-fp4-az-solo.yaml}"
else
  B12X_RECIPE="${B12X_RECIPE:-qwen3.8-flash-next-int4-b12x-solo.yaml}"
fi
# setup.sh records here which stack it set up (SETUP_BACKEND, SETUP_EUGR_DIR); serve.sh's BACKEND=auto follows it. Not in git.
BACKEND_FILE="$(dirname "${BASH_SOURCE[0]}")/.backend"
SETUP_BACKEND=""; SETUP_EUGR_DIR=""
[ -f "$BACKEND_FILE" ] && . "$BACKEND_FILE"
EUGR_DIR="${EUGR_DIR:-${SETUP_EUGR_DIR:-$HOME/spark-vllm-docker}}"
eugr_present(){ [ -x "$EUGR_DIR/run-recipe.sh" ] && [ -d "$EUGR_DIR/mods" ] && [ -d "$EUGR_DIR/recipes" ]; }

# The Orca variant's disclaimer (orca/README.md, from its "Disclaimer" heading to the next section): setup.sh --orca and
# eugr-setup.sh --orca print it every time they run. ORCA_DISCLAIMER_SHOWN=1 = already shown by the calling script.
orca_disclaimer(){
  [ "${ORCA_DISCLAIMER_SHOWN:-0}" = 1 ] && return 0
  local f; f="$(dirname "${BASH_SOURCE[0]}")/orca/README.md"
  [ -f "$f" ] || { echo "orca/README.md is missing -- run 'git pull' in this folder" >&2; return 1; }
  local y=; local r=; if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then y=$'\e[1;33m'; r=$'\e[0m'; fi
  printf '\n%s' "$y"
  awk '/^## .*Disclaimer/{on=1} on && /^## / && !/Disclaimer/{exit} on' "$f" | sed -e 's/^## //' -e 's/\*\*//g'
  printf '%s\n' "$r"
  export ORCA_DISCLAIMER_SHOWN=1
}

# --- derived paths (you should not need to touch anything below) ---------------------------------
# Resolve a repository to the snapshot folder the Hugging Face cache put it in. Empty if not downloaded yet.
hf_snapshot_dir(){
  local repo="$1" d ref
  d="$HF_HOME/hub/models--${repo//\//--}"
  ref="$(cat "$d/refs/main" 2>/dev/null)" || return 1
  [ -d "$d/snapshots/$ref" ] || return 1
  printf '%s\n' "$d/snapshots/$ref"
}
# The folder holding this repo's blobs AND snapshots; it must be mounted whole, because a snapshot
# is symlinks pointing at ../../blobs/<hash>.
hf_repo_root(){ printf '%s\n' "$HF_HOME/hub/models--${1//\//--}"; }

if [ "$DOWNLOAD_MODE" = cache ]; then
  MODEL_DIR="$(hf_snapshot_dir "$MODEL_REPO" 2>/dev/null || true)"
fi
# Fallback to local models dir if not in HF cache snapshots
if [ -z "$MODEL_DIR" ] || [ ! -f "$MODEL_DIR/config.json" ]; then
  if [ -f "$MODELS_DIR/$(basename "$MODEL_REPO")/config.json" ]; then
    MODEL_DIR="$MODELS_DIR/$(basename "$MODEL_REPO")"
  fi
fi
# The n-gram table ships inside the model. TABLE_REPO is the fallback when it does not.
if [ -n "$MODEL_DIR" ] && [ -d "$MODEL_DIR/ple-table" ]; then
  TABLE_DIR="$MODEL_DIR/ple-table"
elif [ "$DOWNLOAD_MODE" = cache ]; then
  TABLE_DIR="$(hf_snapshot_dir "$TABLE_REPO" 2>/dev/null || true)"
else
  TABLE_DIR="$MODELS_DIR/$(basename "$TABLE_REPO")"
fi
# The draft folder is ours, never inside the cache: small, and the cache must stay exactly as the hub wrote it.
DRAFT_DIR="${DRAFT_DIR:-$MODELS_DIR/$(basename "$MODEL_REPO")-draft-k10}"

# Engram Memory Governor settings (from ds4 research stack)
export ENGRAM_CPU_OFFLOAD=0
export ENGRAM_USE_THP=0
export ENGRAM_DP_SHARED_MEMORY=0
